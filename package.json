{
  "name": "smart-image-engine",
  "version": "1.0.0",
  "description": "A free, hybrid AI image generation library — runs Stable Diffusion Turbo locally in-browser via WebGPU, and falls back to a free cloud API (Pollinations) when WebGPU isn't available.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./cache-tools": {
      "import": {
        "types": "./dist/cache-tools.d.ts",
        "default": "./dist/cache-tools.js"
      },
      "require": {
        "types": "./dist/cache-tools.d.cts",
        "default": "./dist/cache-tools.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "image-generation",
    "webgpu",
    "stable-diffusion",
    "transformers.js",
    "text-to-image"
  ],
  "license": "MPL-2.0",
  "dependencies": {
    "@huggingface/transformers": "^3.0.0"
  },
  "devDependencies": {
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18"
  }
}
